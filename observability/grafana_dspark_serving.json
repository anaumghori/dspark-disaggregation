{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Enterprise-grade monitoring for DSpark speculative decoding on DeepSeek-V4-Flash (sm_120). Monitors speculative acceptance, verify windows, request queues, memory pools, and system health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚀 DSpark Performance",
      "type": "row"
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Generation Throughput",
      "description": "Total tokens generated per second across all workers. Primary indicator of serving performance.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "tokens/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(sglang:gen_throughput{instance=~\"$instance\"})",
          "legendFormat": "Total Throughput",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Speculative Acceptance Rate",
      "description": "Fraction of drafted tokens accepted at verification. Values > 0.3 indicate speculation is profitable. Values < 0.2 suggest speculation overhead exceeds benefits.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "acceptance rate",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "green", "value": 0.3 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sglang:spec_accept_rate{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean Accepted Length per Verify Window",
      "description": "Average tokens accepted per verification cycle against the configured window (gamma+1=6). Values near 1.0 mean speculation is not paying off.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "tokens",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1.5 },
              { "color": "green", "value": 2.5 }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sglang:spec_accept_length{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "📊 Request Queue & Latency",
      "type": "row"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Running vs Queued Requests",
      "description": "Active requests in the scheduler. Running requests are being processed; queued requests are waiting for admission. High queue indicates saturation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "requests",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "mode": "normal" }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "running" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "queued" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "grammar-queued" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sglang:num_running_reqs{instance=~\"$instance\"}",
          "legendFormat": "running {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sglang:num_queue_reqs{instance=~\"$instance\"}",
          "legendFormat": "queued {{instance}}",
          "refId": "B"
        },
        {
          "expr": "sglang:num_grammar_queue_reqs{instance=~\"$instance\"}",
          "legendFormat": "grammar-queued {{instance}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Time to First Token (TTFT)",
      "description": "Latency from request arrival to first token generation. Lower is better. Spikes indicate prefill congestion or queue buildup.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "ms",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "p95"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(sglang:time_to_first_token_seconds_bucket{instance=~\"$instance\"}[5m])) * 1000",
          "legendFormat": "p50 {{instance}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(sglang:time_to_first_token_seconds_bucket{instance=~\"$instance\"}[5m])) * 1000",
          "legendFormat": "p95 {{instance}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(sglang:time_to_first_token_seconds_bucket{instance=~\"$instance\"}[5m])) * 1000",
          "legendFormat": "p99 {{instance}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Inter-Token Latency (ITL)",
      "description": "Time between consecutive token generations. Lower is better. Consistent ITL indicates stable decode performance.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "ms",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "p95"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(sglang:inter_token_latency_seconds_bucket{instance=~\"$instance\"}[5m])) * 1000",
          "legendFormat": "p50 {{instance}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(sglang:inter_token_latency_seconds_bucket{instance=~\"$instance\"}[5m])) * 1000",
          "legendFormat": "p95 {{instance}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(sglang:inter_token_latency_seconds_bucket{instance=~\"$instance\"}[5m])) * 1000",
          "legendFormat": "p99 {{instance}}",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "💾 Memory & Cache",
      "type": "row"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "KV Pool Occupancy",
      "description": "GPU memory allocated for KV cache. Approaching 1.0 triggers admission control or request retraction. DeepSeek-V4 has separate full-attention and SWA pools.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "utilization",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "full" },
            "properties": [{ "id": "displayName", "value": "Full Attention Pool" }]
          },
          {
            "matcher": { "id": "byName", "options": "swa" },
            "properties": [{ "id": "displayName", "value": "Sliding Window Pool" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sglang:full_token_usage{instance=~\"$instance\"}",
          "legendFormat": "full {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sglang:swa_token_usage{instance=~\"$instance\"}",
          "legendFormat": "swa {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prefix Cache Hit Rate",
      "description": "Fraction of KV cache lookups that hit the radix cache. Higher values reduce redundant prefill computation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "hit rate",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sglang:cache_hit_rate{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Token Throughput (Prompt vs Generation)",
      "description": "Separate tracking of prompt tokens processed and generation tokens produced. Helps identify whether system is prefill-bound or decode-bound.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "tokens/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "prompt" },
            "properties": [{ "id": "displayName", "value": "Prompt Tokens/s" }]
          },
          {
            "matcher": { "id": "byName", "options": "generation" },
            "properties": [{ "id": "displayName", "value": "Generation Tokens/s" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "rate(sglang:prompt_tokens_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "prompt {{instance}}",
          "refId": "A"
        },
        {
          "expr": "rate(sglang:generation_tokens_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "generation {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "⚠️ Errors & Health",
      "type": "row"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Retractions",
      "description": "Requests retracted due to KV pool exhaustion. Non-zero values indicate memory pressure. Consider increasing --max-running-requests or --mem-fraction-static.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "axisLabel": "retractions/s",
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "rate(sglang:num_retracted_requests_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "retracted/s {{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Transfer & Bootstrap Failures",
      "description": "Failed KV transfers or bootstrap errors. Non-zero indicates NIXL/network issues.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "failures/s",
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "rate(sglang:num_transfer_failed_reqs_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "transfer-failed/s {{instance}}",
          "refId": "A"
        },
        {
          "expr": "rate(sglang:num_bootstrap_failed_reqs_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "bootstrap-failed/s {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "PD KV Transfer",
      "description": "KV cache transfer metrics for prefill/decode disaggregation. Latency spikes with flat throughput indicate PCIe bottleneck.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "GB/s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sglang:kv_transfer_speed_gb_s{instance=~\"$instance\"}",
          "legendFormat": "GB/s {{instance}}",
          "refId": "A"
        },
        {
          "expr": "sglang:kv_transfer_latency_ms{instance=~\"$instance\"}",
          "legendFormat": "latency ms {{instance}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["dspark", "sglang", "deepseek", "speculative-decoding"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(sglang:gen_throughput, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(sglang:gen_throughput, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "label": "Worker Instance"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DSpark Serving (DeepSeek-V4-Flash, sm_120)",
  "uid": "dspark-serving",
  "version": 2
}
